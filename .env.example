# Database from docker-compose.yml, as seen from this Mac (npm run dev, prisma CLI).
# The app container overrides it with host "db" instead of "localhost" (see docker-compose.yml).
DATABASE_URL="postgresql://crosspost:crosspost@localhost:5432/crosspost_dev?schema=public"

# Address you open in the browser; OAuth callbacks are built from it.
APP_URL="http://localhost:3000"

# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# X developer app (OAuth 2.0, Web App). Callback: <APP_URL>/api/oauth/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# LinkedIn developer app. Redirect URL: <APP_URL>/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Optional: LinkedIn API version (YYYYMM). Default in code: 202610. Each version is supported ~1 year.
# LINKEDIN_API_VERSION="202610"
