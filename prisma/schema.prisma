generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Provider {
  X
  LINKEDIN
}

enum PublicationStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  sessions       Session[]
  invitesCreated InviteCode[]       @relation("InviteCreatedBy")
  inviteUsed     InviteCode?        @relation("InviteUsedBy")
  connections    SocialConnection[]
  posts          Post[]
}

// One-time registration code. Only the SHA-256 hash is stored; the plain code
// is shown to the admin once, at creation time.
model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  // If set, only this email address can register with the code.
  email       String?
  role        Role      @default(USER)
  note        String?
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

// The id is the SHA-256 hash of the token kept in the session cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // Shown on the account page so the user can recognize their devices.
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Failed login attempts, used for rate limiting. Old rows are deleted on the next failure.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// OAuth connection to X or LinkedIn. Tokens are encrypted at the application level.
model SocialConnection {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              Provider
  externalId            String
  displayName           String?
  accessTokenEnc        String
  refreshTokenEnc       String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scopes                String?
  // Set when the provider rejected our tokens (e.g. refresh failed); the user must reconnect.
  invalidatedAt         DateTime?
  lastError             String?
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, provider])
}

model Post {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String
  // Generated by the composer per submission; a repeated submit returns the same post.
  clientRequestId String?
  createdAt       DateTime          @default(now())
  publications    PostPublication[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
}

// One publishing attempt of a post on one platform, with the raw API response.
model PostPublication {
  id             String            @id @default(cuid())
  postId         String
  post           Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  provider       Provider
  status         PublicationStatus @default(PENDING)
  externalPostId String?
  postUrl        String?
  httpStatus     Int?
  responseBody   Json?
  errorMessage   String?
  attemptedAt    DateTime          @default(now())

  @@index([postId])
}
